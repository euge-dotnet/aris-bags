# =============================================================================
# Ari´s Bags — variables de entorno (desarrollo local)
# Copiá este archivo a backend/.env y frontend/.env y completá los valores.
# NUNCA subas archivos .env reales al repositorio.
# =============================================================================

# --- Backend (copiar a backend/.env) ---

# PostgreSQL. En local: postgres://USER:PASSWORD@localhost:5432/aris_bags
# Más adelante: connection string de Neon.
DATABASE_URL=

# Secreto para firmar JWT. Usá un valor largo y aleatorio en cada entorno.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Puerto de la API
PORT=4000
NODE_ENV=development

# Orígenes permitidos (CORS). En local: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cloudinary — dejar vacío en local si no hay cuenta.
# Las imágenes de demo usan placeholders; Cloudinary se activa cuando hay credenciales.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aris-bags

# --- Frontend (copiar a frontend/.env) ---

# URL pública de la API
VITE_API_URL=http://localhost:4000
